{
  "manifest_version": 3,
  "name": "WA Channel Exporter",
  "version": "1.3.1",
  "description": "Save WhatsApp Channel posts from WhatsApp Web as portable JSONL and ZIP archives.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "WA Channel Exporter"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/whatsapp-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["src/core/*", "src/shared/*"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
